# Compile-time credentials. Copy to `.env.local` and fill in.
#
# `.env.local` is gitignored and must stay that way — these are read by
# `option_env!` when cargo compiles, so they end up inside the binary. That is
# unavoidable for an installed app and is why the OAuth flows do not rely on
# the secret staying secret. It is still not something to commit.
#
# Then: npm run dev:app

# Larimar has no OAuth apps of its own yet, so builds leave these empty and
# WordPress.com publishing and Google Calendar report themselves unavailable.

# https://developer.wordpress.com/apps/ — redirect URI larimar://oauth/wordpress
LARIMAR_WPCOM_CLIENT_ID=
LARIMAR_WPCOM_CLIENT_SECRET=

# Google Cloud console, an OAuth client for a desktop app
LARIMAR_GOOGLE_CLIENT_ID=
LARIMAR_GOOGLE_CLIENT_SECRET=
