{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Larimar",
  "version": "0.1.0",
  "identifier": "app.larimar",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Moldavite",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "disableInputAccessoryView": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$DOCUMENT/Larimar/**"
          ],
          "deny": [
            "$DOCUMENT/Larimar/**/.plugins/**",
            "$DOCUMENT/Larimar/**/.trash/**",
            "$DOCUMENT/Larimar/**/.index/**",
            "$DOCUMENT/Larimar/**/*.md",
            "$DOCUMENT/Larimar/**/*.locked",
            "$DOCUMENT/Larimar/**/*.json"
          ]
        }
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "(?:https?://[^\\s]+|mailto:[^\\s]+|x-apple\\.systempreferences:com\\.apple\\.preference\\.security\\?Privacy_Calendars)"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "larimar"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NjQ2MUQxM0FCMkZCNUYKUldSZis3STYwV0ZrRmprb3dEMy9ray9DS1IzaVduSUw3OTNaKzE1QjFzTGVYa2hDdFlWdDU5YkQK",
      "endpoints": [
        "https://github.com/jiegui2025/larimar/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "contentTypes": [
          "net.daringfireball.markdown"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "resources": [
      "example-plugin/larimar-wordpress/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A local-first note-taking app for connected thinking",
    "longDescription": "Moldavite is a privacy-first note-taking app with rich text editing, daily notes, wiki-style linking, and calendar integration. Forged from cosmic impact.",
    "macOS": {
      "entitlements": "Larimar.entitlements",
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/larimar.desktop",
        "depends": [
          "libc6 (>= 2.38)"
        ]
      },
      "rpm": {
        "desktopTemplate": "linux/larimar.desktop",
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
